# ================================================================
#  Environment Configuration
# ================================================================
#  Copy this file to ".env" and fill in your values:
#     cp .env.example .env        (macOS/Linux/Git Bash)
#     copy .env.example .env      (Windows CMD)
#
#  ⚠️  NEVER commit your real .env file. It is git-ignored.
# ================================================================

# ─── PRIMARY ENGINE: Google Gemini ───────────────────────────────
# Get a free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─── FALLBACK ENGINE: OpenAI-compatible API ──────────────────────
# Used automatically when Gemini quota is exhausted.
# Works with: OpenAI, Groq, Together, OpenRouter, Ollama, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ─── Pipeline Settings ───────────────────────────────────────────
# Number of contracts to process (assignment asks for 50)
MAX_CONTRACTS=50

# Directory where your contract PDFs live
CONTRACTS_DIR=data/raw/contracts

# Output directory for CSV / JSON results
OUTPUT_DIR=output

# Extraction mode: "zero_shot" or "few_shot"
EXTRACTION_MODE=zero_shot

# Enable bonus semantic search on the results (true/false)
ENABLE_SEMANTIC_SEARCH=true

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
