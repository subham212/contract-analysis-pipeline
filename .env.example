# ================================================================
#  Environment Configuration
# ================================================================
#  Copy this file to ".env" and fill in your values:
#     cp .env.example .env        (macOS/Linux/Git Bash)
#     copy .env.example .env      (Windows CMD)
#
#  ⚠️  NEVER commit your real .env file. It is git-ignored.
# ================================================================

# ─── PRIMARY ENGINE: ZenMux (OpenAI-compatible) ───────────────────
# Base URL for ZenMux API Gateway:
OPENAI_BASE_URL=https://zenmux.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-v4.1-flash
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
# Paste your ZenMux API key below:
OPENAI_API_KEY=
PROVIDER_ORDER=openai-compat

# ─── Pipeline Settings ───────────────────────────────────────────
# Number of contracts to process (assignment asks for 50)
MAX_CONTRACTS=50

# Directory where your contract PDFs live
CONTRACTS_DIR=data/raw/contracts

# Output directory for CSV / JSON results
OUTPUT_DIR=output

# Extraction mode: "zero_shot" or "few_shot"
EXTRACTION_MODE=zero_shot

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
