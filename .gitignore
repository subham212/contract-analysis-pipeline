# ─── Secrets (NEVER commit these) ────────────────────────────────
.env
.env.local
*.key

# ─── Python ──────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# ─── Virtual env / IDE ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Data (large files — don't bloat the repo) ───────────────────
data/raw/
data/processed/*.tmp
!data/raw/.gitkeep
!data/processed/.gitkeep

# ─── Output (regenerated by the pipeline) ────────────────────────
output/*.csv
output/*.json
!output/.gitkeep

# ─── Logs ────────────────────────────────────────────────────────
*.log
logs/
