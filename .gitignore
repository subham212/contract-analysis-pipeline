# ─── Secrets (NEVER commit these) ────────────────────────────────
.env
.env.local
*.key

# ─── Python ──────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# ─── Virtual env / IDE ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Data (large files — don't bloat the repo) ───────────────────
data/raw/
!data/raw/.gitkeep

# ─── Output ──────────────────────────────────────────────────────
# Keep intermediate batch files local (regenerated by pipeline)
# but ship the final deliverables so reviewers can see results.
output/batch_*.csv
output/batch_*.json
output/fix_*.csv
output/fix_*.json
output/fill_*.csv
output/fill_*.json
output/*.log
# NOTE: final_contracts.csv, final_contracts.json, semantic_index.json
# are NOT ignored → they WILL be uploaded to GitHub as deliverables.

# ─── Logs ────────────────────────────────────────────────────────
*.log
logs/
